{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Base settings. `wrangler dev` and the tests use these.
  // Deploy only with `--env staging` or `--env production` (see package.json scripts).
  "name": "tracklist-finder",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,

  // Static files (page, script, styles, fonts) are served straight from Cloudflare's
  // asset store without running the Worker, so they don't count against the free
  // plan's daily request limit. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },
  "upload_source_maps": true,

  "vars": {
    "ENVIRONMENT": "development",
    "VERSION": "dev",
    // Shown to the Internet Archive in the User-Agent header so they can reach you
    // if this tool ever causes them trouble. Use a URL or mailto: address.
    "CONTACT": "https://github.com/NadimNadimNadimNadimNadim/tracklist-finder"
  },

  // Local-only placeholder. `wrangler dev` and tests simulate KV locally.
  "kv_namespaces": [{ "binding": "CACHE", "id": "00000000000000000000000000000000" }],

  // Rate limiters. `period` must be 10 or 60 seconds. Limits apply per Cloudflare location.
  // namespace_id values must be unique within your Cloudflare account.
  // CLIENT_LIMITER counts lookups per visitor. ARCHIVE_LIMITER counts requests to the
  // Wayback Machine from the whole service (a typical uncached lookup makes 4).
  "ratelimits": [
    { "name": "CLIENT_LIMITER", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    { "name": "ARCHIVE_LIMITER", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }
  ],

  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "VERSION": "unset",
        "CONTACT": "https://github.com/NadimNadimNadimNadimNadim/tracklist-finder"
      },
      // Filled in by `npm run bootstrap`.
      "kv_namespaces": [{ "binding": "CACHE", "id": "daa7e2ae8e6045a4aa5cbffad1f0ebd5" }],
      "ratelimits": [
        { "name": "CLIENT_LIMITER", "namespace_id": "2101", "simple": { "limit": 30, "period": 60 } },
        { "name": "ARCHIVE_LIMITER", "namespace_id": "2102", "simple": { "limit": 30, "period": 60 } }
      ]
    },
    "production": {
      // Keep true until your custom domain is live, then set to false so the
      // site has a single address.
      "workers_dev": true,
      // Uncomment and set your domain once it's added to Cloudflare (see README).
      // "routes": [{ "pattern": "tracklist.YOURNAME.dpdns.org", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "VERSION": "unset",
        "CONTACT": "https://github.com/NadimNadimNadimNadimNadim/tracklist-finder"
      },
      // Filled in by `npm run bootstrap`.
      "kv_namespaces": [{ "binding": "CACHE", "id": "48232e3545524c1fa6ff01d574533199" }],
      "ratelimits": [
        { "name": "CLIENT_LIMITER", "namespace_id": "3101", "simple": { "limit": 30, "period": 60 } },
        { "name": "ARCHIVE_LIMITER", "namespace_id": "3102", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
